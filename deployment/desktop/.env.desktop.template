# .env.desktop.template — ForgeOS Desktop Migration
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.desktop (in the same directory as docker-compose.desktop.yml)
# 2. Fill in values from your Vercel Production environment variables
# 3. NEVER commit .env.desktop to git (it's in .gitignore)
# 4. NEVER paste these values in chat
#
# Source for values: Vercel dashboard → forgeos project → Settings → Environment Variables (Production)

# --- REQUIRED ---
# Dashboard admin token (used for Provider Hub, admin API routes)
FORGEOS_ADMIN_TOKEN=

# Gateway admin token (dashboard → gateway admin proxy auth)
FORGEOS_GATEWAY_ADMIN_TOKEN=

# ForgeOS service keys (for My Dots, PinDrop, Position AI, Quant)
FORGEOS_MYDOTS_KEY=
FORGEOS_PINDROP_KEY=
FORGEOS_POSITION_AI_KEY=
FORGEOS_QUANT_KEY=

# Governor API token (for workforce task management)
GOVERNOR_API_TOKEN=

# OpenRouter API key (for AI inference via OpenRouter)
FORGEOS_OPENROUTER_KEY=

# --- OPTIONAL (leave empty if not used) ---
GITHUB_TOKEN=
MEDIUM_TOKEN=
PINTEREST_ACCESS_TOKEN=
