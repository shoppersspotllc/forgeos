# ForgeOS v2.0 — Portable Configuration
# Copy to .env and fill in your values. Never commit .env.

# === Identity ===
FORGEOS_IDENTITY_URL=https://mcp.shoppersspotllc.com/
FORGEOS_VERSION=2.0.0
FORGEOS_HOME=/forgeos

# === Ports ===
DASHBOARD_PORT=3456
OLLAMA_PORT=11434
TERMINAL_PORT=3457
FORGEOS_AI_PORT=8788
WORKFORCE_PORT=4310

# === Endpoints (override for remote services) ===
OLLAMA_ENDPOINT=http://127.0.0.1:11434
FORGEOS_AI_ENDPOINT=http://127.0.0.1:8788

# === Secrets (fill via secure mechanism, never commit) ===
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# GITHUB_TOKEN=
# GOOGLE_DRIVE_CREDENTIALS_PATH=/forgeos/secrets/google-drive.json
